---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import AddToCalendar from '../components/AddToCalendar.astro';
import { site } from '../lib/content';
import { calendar } from '../lib/content';
import { u } from '../lib/url';
import { dateRange, shortDate } from '../lib/schedule';

const classDays = calendar.sundays.filter((s) => s.status !== 'no-school');
const months: { name: string; days: { n: number; date: string; cls: string; label: string }[] }[] = [];
// Every Sunday in the year, so the month boxes show holidays too.
const sundays = [...calendar.sundays].sort((a, b) => a.date.localeCompare(b.date));
for (const s of sundays) {
  const d = new Date(s.date + 'T12:00:00Z');
  const name = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  let m = months.find((x) => x.name === name);
  if (!m) months.push((m = { name, days: [] }));
  const [cls, label] =
    s.status === 'no-school' ? ['day-off', `No school${s.note ? ` (${s.note})` : ''}`]
    : s.status === 'possible-virtual' ? ['day-maybe', 'Possible virtual class']
    : s.status === 'virtual' ? ['day-virtual', 'Virtual class (Google Meet)']
    : ['day-class', 'Class day'];
  m.days.push({ n: d.getUTCDate(), date: s.date, cls, label });
}
const hasVirtual = classDays.some((s) => s.status === 'virtual');
const first = classDays[0]?.date;
const last = classDays[classDays.length - 1]?.date;
const holidays = calendar.sundays.filter((s) => s.status === 'no-school');
const events = [...calendar.events].sort((a, b) => a.date.localeCompare(b.date));
---
<Base title={`Calendar ${calendar.schoolYear}`} current="calendar" description={`School calendar ${calendar.schoolYear}: class days, holidays, events and deadlines.`}>
  <Hero eyebrow={`${calendar.schoolYear} · ${calendar.hijriYear}`} title="Calendar" lead={`${classDays.length} Sundays · ${shortDate(first)} to ${shortDate(last)}`}>
    <AddToCalendar variant="dark" />
    {site.pdfCalendar && <a class="btn btn-ghost" href={u(site.pdfCalendar)} target="_blank" rel="noopener"><Icon name="download" />PDF<span class="sr-only"> (opens in a new tab)</span></a>}
  </Hero>

  <section class="wrap pt-major" aria-labelledby="months-title">
    <h2 id="months-title" class="sr-only">Class Days by Month</h2>
    <div class="legend">
      <span><span class="swatch swatch-class"></span>Class day</span>
      {hasVirtual && <span><span class="swatch swatch-virtual"></span>Virtual (Google Meet)</span>}
      <span><span class="swatch swatch-maybe"></span>Possible virtual class</span>
      <span><span class="swatch swatch-off"></span>No school</span>
    </div>
    <div class="months">
      {months.map((m) => (
        <div class="card card-sm month">
          <h3>{m.name}</h3>
          <ul class="days">
            {m.days.map((d) => (
              <li class={`day ${d.cls}`} title={d.label} data-date={d.date}>
                <span aria-hidden="true">{d.n}</span><span class="sr-only">{shortDate(d.date)}: {d.label}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap pt-block section-last grid grid-2">
    <div class="card">
      <h2 class="h-section mb-12">Events &amp; Deadlines</h2>
      <ul class="rows">
        {events.map((e) => <li class="row"><span class="row-key">{dateRange(e.date, e.end)}</span><span>{e.title}</span></li>)}
      </ul>
    </div>
    <div class="card self-start">
      <h2 class="h-section mb-12">No School</h2>
      <ul class="rows">
        {holidays.map((h) => <li class="row"><span class="row-key">{shortDate(h.date)}</span><span>{h.note || 'No school'}</span></li>)}
      </ul>
      <p class="note mt-14">Virtual days are confirmed by email the week before. Subscribed calendars update automatically.</p>
    </div>
  </section>
</Base>

<script>
  import { todayISO, upcomingSunday } from '../lib/schedule';
  // Ring the upcoming Sunday.
  const next = upcomingSunday();
  if (next >= todayISO()) document.querySelector(`.day[data-date="${next}"]`)?.classList.add('today');
</script>
