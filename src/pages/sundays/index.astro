---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import SundaysNav from '../../components/SundaysNav.astro';
import { site, curriculum as cur } from '../../lib/content';
import { u } from '../../lib/url';

const directions = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(site.address || site.location);
const guides = [
  { href: '/sundays/getting-here/', icon: 'car', title: 'Parking & Pick-Up', text: 'Where to park at Greene, the volunteers in green vests, and how pick-up works at 1:30.' },
  { href: '/sundays/campus/', icon: 'map', title: 'Campus Map', text: 'Which wings our classes are in, where events and prayer happen, and what’s off-limits.' },
  { href: '/sundays/online/', icon: 'laptop', title: 'Online Classes', text: 'Google Classroom and Meet, step by step, for students, parents and teachers.' },
  { href: '/families/', icon: 'book', title: 'Parent Handbook', text: 'Late policy, attendance, dress code, conduct and the rest of the rules.' },
] as const;
---
<Base title="Sundays at ISSV" current="sundays" description="Everything for a school Sunday: parking, pick-up, the campus map and online classes.">
  <Hero eyebrow="Sundays at ISSV" title="Your Sunday, Start to Finish" lead={`Classes run ${site.hours.replace('Sundays ', '')} at ${site.location}. Here’s how the day works.`}>
    <a class="btn btn-primary" href={u('/sundays/getting-here/')}><Icon name="car" />Parking &amp; Pick-Up</a>
    <a class="btn btn-outline" href={directions} target="_blank" rel="noopener"><Icon name="pin" />Directions<span class="sr-only"> (opens in a new tab)</span></a>
  </Hero>
  <SundaysNav current="hub" />

  <section class="wrap pt-major" aria-labelledby="guides-title">
    <h2 class="h-section mb-16" id="guides-title">Guides</h2>
    <div class="grid grid-4">
      {guides.map((g) => (
        <a class="guide-card" href={u(g.href)}>
          <span class="guide-icon"><Icon name={g.icon} size={22} /></span>
          <span class="h-card">{g.title}</span>
          <span class="small-muted">{g.text}</span>
          <span class="text-link">Open guide <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap pt-major section-last" aria-labelledby="day-title">
    <div class="grid grid-2w">
      <div class="card">
        <h2 class="h-section mb-20" id="day-title">A Sunday at ISSV</h2>
        <ol class="timeline">
          <li><span class="t-time">9:45</span><span class="t-what"><b>Arrive and park</b><span class="small-muted">Follow the volunteers in green vests to your wing.</span></span></li>
          {cur.schedule.map((s) => (
            <li><span class="t-time">{s.time.split('–')[0]}</span><span class="t-what"><b>{s.what}</b><span class="small-muted">{s.time}</span></span></li>
          ))}
          <li><span class="t-time">1:30</span><span class="t-what"><b>Pick-up</b><span class="small-muted">KG–Grade 8 are picked up from the classroom by a parent or guardian.</span></span></li>
        </ol>
      </div>
      <div class="stack stack-md">
        <div class="card card-sm card-highlight stack">
          <span class="label">Missing a Sunday?</span>
          <span class="text-16">Use the absence form. Please don’t call.</span>
          <a class="btn btn-primary self-start" href={site.absenceFormUrl}>Report an Absence</a>
        </div>
        <div class="card card-sm stack">
          <span class="label">Virtual Sunday?</span>
          <span class="text-16">The calendar and the home page show it. Join from your class in Google Classroom, signed in with your school account.</span>
          <a class="text-link" href={u('/sundays/online/')}>Online class guide <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="card card-sm stack">
          <span class="label">Where</span>
          <b>{site.location}</b>
          <span class="small-muted">{site.address}</span>
          <a class="text-link" href={directions} target="_blank" rel="noopener">Get directions <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>
