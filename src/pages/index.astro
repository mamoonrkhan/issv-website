---
import '@fontsource/amiri/arabic-400.css';
import Base from '../layouts/Base.astro';
import Pattern from '../components/Pattern.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import AddToCalendar from '../components/AddToCalendar.astro';
import site from '../data/site.json';
import calendar from '../data/calendar.json';
import override from '../data/sunday.json';
import payment from '../data/payment.json';
import { getCollection } from 'astro:content';
import { thisSunday, comingUp, todayISO, isLive } from '../lib/schedule';
import { u } from '../lib/url';

const sun = thisSunday(calendar, override);
const upcoming = comingUp(calendar, sun.date, 4);

const iso = (d?: Date) => (d ? d.toISOString().slice(0, 10) : '');
const today = todayISO();
// Keep anything that isn't expired yet; the browser hides ones whose start date hasn't come.
// The newest banner announcement already shows in the top bar, so leave it out here.
const all = (await getCollection('announcements'))
  .filter((a) => !a.data.hideAfter || iso(a.data.hideAfter) >= today)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const bannerId = all.find((a) => a.data.banner)?.id;
const news = all.filter((a) => a.id !== bannerId).slice(0, 3);

const directions = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(site.address || site.location);
---
<Base description={site.lead}>
  <section class="hero home-hero">
    <Pattern id="geo-home" opacity={0.14} />
    <div class="wrap">
      <div class="hero-text">
        <p class="bismillah" lang="ar" dir="rtl">بسم الله الرحمن الرحيم</p>
        <h1>{site.tagline}</h1>
        <p class="lead">{site.lead}</p>
        <div class="hero-actions">
          <a class="btn btn-gold btn-lg" href={u('/new-families/')}>New Families Start Here</a>
          <a class="btn btn-ghost btn-lg" href={u('/registration/')}>Register &amp; Pay</a>
        </div>
      </div>
      <div class="hero-photo">
        <Photo image={site.heroImage} alt={site.heroImageAlt} placeholder="[PHOTO: the school building]" sizes="(min-width: 1160px) 440px, 100vw" eager />
        {site.heroImage && site.heroImageCredit && (
          <a class="photo-credit" href={site.heroImageCreditUrl || undefined}>{site.heroImageCredit}</a>
        )}
      </div>
    </div>
  </section>

  <section class="sunday wrap" aria-labelledby="sunday-title">
    <div class="sunday-card" data-sunday>
      <div class="sunday-text">
        <div class="sunday-meta">
          <span class="label">This Sunday · <span data-f="label">{sun.label}</span></span>
          <span class={`pill tone-${sun.tone}`} data-f="badge">{sun.badge}</span>
        </div>
        <h2 id="sunday-title" data-f="title">{sun.title}</h2>
        <p data-f="detail">{sun.detail}</p>
      </div>
      <div class="sunday-actions">
        <a class="btn btn-primary" href={site.absenceFormUrl}>Report an Absence</a>
        <AddToCalendar />
      </div>
      {news.length > 0 && (
        <div class="sunday-news">
          <h3 class="news-heading"><Icon name="megaphone" size={18} />Announcements</h3>
          <ul class="news">
            {news.map((n) => (
              <li
                data-show-from={iso(n.data.showFrom)}
                data-hide-after={iso(n.data.hideAfter)}
                hidden={!isLive(iso(n.data.showFrom), iso(n.data.hideAfter), today)}
              >
                <span class="news-icon"><Icon name="megaphone" size={20} /></span>
                <div>
                  <span class="news-title">{n.data.title}</span>
                  <span class="news-text">{n.body?.trim()}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="wrap pt-block grid grid-2">
    <div class="card card-sm">
      <div class="section-head mb-8">
        <h2 class="h-card">Coming Up</h2>
        <a class="text-link" href={u('/calendar/')}>Calendar <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="rows" data-upcoming>
        {upcoming.map((e) => (
          <li class="row"><span class="row-key w64">{e.label}</span><span>{e.title}</span></li>
        ))}
      </ul>
    </div>
    <div class="card card-sm">
      <h2 class="h-card mb-8">For Parents</h2>
      <a class="link-row" href={u('/registration/#pay')}>Pay Tuition<span class="arrow" aria-hidden="true">→</span></a>
      <a class="link-row" href={u('/families/')}>Parent Handbook<span class="arrow" aria-hidden="true">→</span></a>
      <a class="link-row" href={u('/curriculum/')}>Curriculum by Grade<span class="arrow" aria-hidden="true">→</span></a>
      <a class="link-row" href={u('/families/#volunteer')}>Volunteer Hours<span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="wrap pt-major section-last" aria-labelledby="glance-title">
    <h2 class="h-section mb-16" id="glance-title">At a Glance</h2>
    <div class="glance card">
      <div class="glance-item">
        <span class="label">Where</span>
        <b>{site.location}</b>
        <a class="text-link" href={directions} target="_blank" rel="noopener">Get Directions <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="glance-item">
        <span class="label">When</span>
        <b>{site.hours}</b>
        <span class="small-muted">September through May</span>
      </div>
      <div class="glance-item">
        <span class="label">Who</span>
        <b>Ages 5–16</b>
        <span class="small-muted">KG through Youth Group (Grades 9–10)</span>
      </div>
      <div class="glance-item">
        <span class="label">Tuition</span>
        <b>${payment.tuitionPerChild} per child, per year</b>
        <a class="text-link" href={u('/registration/')}>Registration Details <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<script>
  import calendar from '../data/calendar.json';
  import override from '../data/sunday.json';
import payment from '../data/payment.json';
  import { thisSunday, comingUp } from '../lib/schedule';

  // Recompute on load so the card is right even between rebuilds.
  const card = document.querySelector<HTMLElement>('[data-sunday]');
  if (card) {
    const s = thisSunday(calendar, override);
    const set = (f: string, v: string) => { const el = card.querySelector(`[data-f="${f}"]`); if (el) el.textContent = v; };
    set('label', s.label); set('badge', s.badge); set('title', s.title); set('detail', s.detail);
    const badge = card.querySelector('[data-f="badge"]');
    if (badge) badge.className = `pill tone-${s.tone}`;

    const list = document.querySelector<HTMLElement>('[data-upcoming]');
    if (list) {
      list.replaceChildren(...comingUp(calendar, s.date, 4).map((e) => {
        const li = document.createElement('li');
        li.className = 'row';
        const k = document.createElement('span'); k.className = 'row-key w64'; k.textContent = e.label;
        const t = document.createElement('span'); t.textContent = e.title;
        li.append(k, t);
        return li;
      }));
    }
  }
</script>

