---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import hb from '../data/handbook.json';
import { u } from '../lib/url';
---
<Base title="Parent Handbook" current="families" description="Arrival, pick-up, attendance, dress code, conduct and other school policies at a glance.">
  <Hero eyebrow="School Policies" title="Parent Handbook" lead={hb.lead}>
    {site.pdfGuidelines && <a class="btn btn-ghost" href={u(site.pdfGuidelines)}><Icon name="download" />Full guidelines (PDF)</a>}
  </Hero>

  <section class="wrap pt-major" aria-label="Essentials">
    <div class="grid grid-tiles">
      <div class="card card-sm stack stack-xs">
        <span class="label">Arrive by</span>
        <span class="big-stat">10:00 AM</span>
        <span class="small-muted">Late? Park and sign in at the desk.</span>
      </div>
      <div class="card card-sm stack stack-xs">
        <span class="label">Pick up at</span>
        <span class="big-stat">1:30 PM</span>
        <span class="small-muted">$1 per minute late, per child.</span>
      </div>
      <div class="card card-sm card-highlight stack">
        <span class="label">Missing a Sunday?</span>
        <span class="text-16">Use the form. Please don’t call.</span>
        <a class="btn btn-primary self-start" href={site.absenceFormUrl}>Report an absence</a>
      </div>
    </div>
  </section>

  <section class="wrap pt-block section-last">
    <nav class="jump card card-sm" aria-label="Handbook sections">
      <span class="label">Jump to</span>
      <ul>
        {hb.sections.map((s) => <li><a class="chip" href={`#${s.id}`}>{s.title}</a></li>)}
      </ul>
    </nav>
    <div class="card card-list handbook mt-gap">
      {hb.sections.map((s, i) => (
        <details class="disclosure" open={i === 0}>
          <summary><h2 id={s.id}>{s.title}</h2><Icon name="chevron" size={20} class="chev" /></summary>
          <ul class="body">{s.items.map((it) => <li>{it}</li>)}</ul>
        </details>
      ))}
    </div>
  </section>
</Base>


<script>
  // Old links like /families/#books open the matching section.
  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    const details = target?.closest('details');
    if (details) { details.open = true; target!.scrollIntoView({ block: 'start' }); }
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
  // Re-clicking the current section link doesn't change the hash, so handle clicks too.
  document.querySelectorAll<HTMLAnchorElement>('.jump a').forEach((a) =>
    a.addEventListener('click', () => setTimeout(openFromHash, 0))
  );
</script>
