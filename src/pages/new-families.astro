---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import faq from '../data/faq.json';
import payment from '../data/payment.json';
import { u } from '../lib/url';
---
<Base title="New families" description="Everything you need to know before your first Sunday at the Islamic School of Silicon Valley.">
  <Hero title="Welcome, new families" lead="Everything you need to know before your first Sunday.">
    <a class="btn btn-gold" href={u('/registration/')}>Registration details</a>
  </Hero>

  <section class="wrap section-first">
    <div class="card">
      <h2 class="h-card" style="margin-bottom: 20px">How joining works</h2>
      <ol class="steps" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr))">
        <li class="tile"><span class="step-when">MAY</span><span class="step-title">Check for openings</span><span class="small-muted">We post open grades after current families pre-register.</span></li>
        <li class="tile"><span class="step-when">{payment.newFamilies.toUpperCase()}</span><span class="step-title">Register in person</span><span class="small-muted">At school, with forms and fall tuition. Seats left? Again in early fall, until {payment.registrationCloses}.</span></li>
        <li class="tile"><span class="step-when">SEP 13</span><span class="step-title">First day of school</span><span class="small-muted">Arrive by 10:00 AM for assembly. Pick up at 1:30 PM.</span></li>
      </ol>
    </div>
  </section>

  <section class="wrap section grid grid-2">
    <div class="card">
      <h2 class="h-plain" style="font-size: 20px; margin-bottom: 12px">Good to know</h2>
      <ul class="bullets">
        <li>Modest, loose clothing; girls wear a headscarf</li>
        <li>Phones off, toys and games stay home</li>
        <li>Snacks are provided; tell us about allergies</li>
        <li>Label belongings (there’s no lost and found)</li>
        <li>Each family volunteers 10 hours a year</li>
      </ul>
      <a class="text-link" href={u('/families/')} style="display: inline-block; margin-top: 14px">Read the handbook <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="nf-photo"><Photo placeholder="[PHOTO: classroom or first-day welcome]" caption="" /></div>
  </section>

  <section class="wrap section section-last">
    <div class="card card-list">
      <h2 class="h-card" style="margin: 16px 0 4px">Questions parents ask</h2>
      {faq.items.map((f) => (
        <details class="disclosure">
          <summary><span class="q">{f.q}</span><Icon name="chevron" size={20} class="chev" /></summary>
          <p class="body">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .nf-photo :global(.photo), .nf-photo :global(.frame) { height: 100%; }
  .nf-photo :global(.frame) { min-height: 260px; aspect-ratio: auto; }
</style>
