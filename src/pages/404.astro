---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { u } from '../lib/url';
---
<Base title="Page Not Found" index={false}>
  <Hero eyebrow="Error 404" title="We Can’t Find That Page" lead="It may have moved when the site was updated. Try searching, or start from the home page.">
    <a class="btn btn-gold" href={u('/search/')}>Search the Site</a>
    <a class="btn btn-ghost" href={u('/')}>Home Page</a>
  </Hero>
  <div class="page-end"></div>
</Base>
