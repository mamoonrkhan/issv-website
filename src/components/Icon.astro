---
// Small stroke icons. Decorative: the surrounding control carries the label.
interface Props { name: 'search' | 'menu' | 'close' | 'calendar' | 'download' | 'chevron' | 'copy' | 'megaphone'; size?: number; class?: string; }
const { name, size = 18, class: cls } = Astro.props;
const paths: Record<Props['name'], string> = {
  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  calendar: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4M12 13v5M9.5 15.5h5"/>',
  download: '<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>',
  chevron: '<path d="M6 9l6 6 6-6"/>',
  copy: '<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h8"/>',
  megaphone: '<path d="M3 11l16-6v14L3 13z"/><path d="M7 13.5V18a2 2 0 0 0 4 0v-3"/><path d="M21 9v6"/>',
};
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={paths[name]} />
