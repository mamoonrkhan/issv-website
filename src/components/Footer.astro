---
import Pattern from './Pattern.astro';
import Email from './Email.astro';
import site from '../data/site.json';
import { u } from '../lib/url';
const donate = site.donationUrl || u('/about/#support');
const year = new Date().getFullYear();
---
<div class="pattern-strip" aria-hidden="true"><Pattern id="geo-strip" small /></div>
<footer class="site-footer">
  <div class="wrap top">
    <div class="who">
      <span class="name">{site.name}</span>
      <span>{site.location} · {site.hours}</span>
      <Email address={site.emailGeneral} />
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href={u('/about/')}>About</a></li>
        <li><a href={u('/new-families/')}>New Families</a></li>
        <li><a href={u('/calendar/')}>Calendar</a></li>
        <li><a href={u('/families/')}>Handbook</a></li>
        <li><a href={u('/registration/')}>Registration</a></li>
        <li><a class="btn btn-gold" href={donate}>Donate</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap bottom">
    <span>© {year} {site.name} · 501(c)(3) nonprofit · Run by volunteers</span>
    <span><a href={u('/search/')}>Search</a> · <a href={u('/calendar.ics')}>Calendar Feed</a> · <a href={u('/admin/')}>For Volunteers</a></span>
  </div>
</footer>
