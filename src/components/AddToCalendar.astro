---
// Subscribe buttons for the school calendar feed: Google, and Apple/Outlook (webcal).
// No dropdown, so nothing can overlap or shift the page in any browser.
import Icon from './Icon.astro';
import { u } from '../lib/url';

interface Props { variant?: 'light' | 'dark'; }
const { variant = 'light' } = Astro.props;
const ics = new URL(u('/calendar.ics'), Astro.site).href;
const webcal = ics.replace(/^https?:/, 'webcal:');
const google = 'https://calendar.google.com/calendar/render?cid=' + encodeURIComponent(webcal);
const primary = variant === 'dark' ? 'btn-gold' : 'btn-outline';
const secondary = variant === 'dark' ? 'btn-ghost' : 'btn-outline';
---
<div class={`add-cal add-cal-${variant}`}>
  {variant === 'light' && <span class="add-cal-label" id="add-cal-label">Add to Your Calendar</span>}
  <div class="add-cal-buttons" role="group" aria-label="Add school dates to your calendar">
    <a class={`btn ${primary}`} href={google} target="_blank" rel="noopener">
      <Icon name="calendar" />{variant === 'dark' ? 'Add to Google Calendar' : 'Google'}
    </a>
    <a class={`btn ${secondary}`} href={webcal}>
      <Icon name="calendar" />{variant === 'dark' ? 'Add to Apple / Outlook' : 'Apple / Outlook'}
    </a>
  </div>
</div>
