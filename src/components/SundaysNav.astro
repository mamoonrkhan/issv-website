---
// Sub-menu shared by the pages in the Sundays section.
import Icon from './Icon.astro';
import { u } from '../lib/url';
interface Props { current: 'hub' | 'getting-here' | 'campus' | 'online'; }
const { current } = Astro.props;
const items = [
  { key: 'hub', href: '/sundays/', label: 'Overview', icon: 'clock' },
  { key: 'getting-here', href: '/sundays/getting-here/', label: 'Parking & Pick-Up', icon: 'car' },
  { key: 'campus', href: '/sundays/campus/', label: 'Campus Map', icon: 'map' },
  { key: 'online', href: '/sundays/online/', label: 'Online Classes', icon: 'laptop' },
] as const;
---
<nav class="subnav wrap" aria-label="Sundays at ISSV">
  <ul>
    {items.map((i) => (
      <li><a href={u(i.href)} aria-current={current === i.key ? 'page' : undefined}><Icon name={i.icon} />{i.label}</a></li>
    ))}
  </ul>
</nav>
