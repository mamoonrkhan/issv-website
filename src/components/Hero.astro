---
// Page header used on every page except Home: label, title, one-line lead, then optional buttons.
import Pattern from './Pattern.astro';
interface Props { eyebrow: string; title: string; lead: string; }
const { eyebrow, title, lead } = Astro.props;
---
<section class="hero">
  <Pattern id="geo-hero" opacity={0.12} />
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    {Astro.slots.has('default') && <div class="hero-actions"><slot /></div>}
  </div>
</section>
